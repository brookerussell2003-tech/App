# Copy to .env and fill in. Never commit .env.
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox uses Plaid's test banks (user_good / pass_good). Switch to production once Plaid approves you.
PLAID_ENV=sandbox
# Generate both with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# APP_TOKEN is the password you type into the web app.
APP_TOKEN=
PORT=8787
DB_PATH=money-book.db
