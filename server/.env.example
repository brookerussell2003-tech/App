# Copy to .env for running on your computer. Never commit .env.
# On Vercel, enter the same names under Settings > Environment Variables.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox uses Plaid's test banks (user_good / pass_good). Switch to production once Plaid approves you.
PLAID_ENV=sandbox

# The password you type to unlock the app.
APP_TOKEN=
# Any long random text (30+ characters). Encrypts your bank connections; never change it after linking banks.
ENCRYPTION_KEY=

# Where data is stored. Leave empty on your computer to use a local file.
# On Vercel, use your free Turso database: libsql://<name>-<you>.turso.io and its token.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
